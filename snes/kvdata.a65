; kv_* value tables: the preset lists behind every OPTTYPE_KVBYTE menu entry, on their
; own in bank $C2 (they left $C0 for $C1 when $C0 ran out, and $C2 when $C1 did, for the
; saves screen).  Any bank works: both readers take the bank from the entry's own pointer
; (see below), never from DBR.
.link page $c2
#include "memmap.i65"
; memmap.i65 re-asserts '.link page $c0' on include; re-declare $c2 AFTER it (last
; '.link page' wins and they emit no bytes) so every byte of this object lands in $C2.
.link page $c2

; ======================================================================
;  kv_* value tables -- the preset lists behind every OPTTYPE_KVBYTE menu
;  entry.  Moved out of snes/menudata.a65 for space: they are ~600 bytes
;  of pure data and $C0 had run down to a few dozen bytes of tail.
;
;  Safe because both readers take the bank from the entry itself, never from
;  DBR: menu_edit_value stashes the entry's bank byte in w_kvtab_bank and does
;  `pha : plb` around jsr menu_kv_lookup, and menu_value_dialog_kv8 does the
;  same from w_preset_bank.  menu_kv_lookup itself reads `lda !$0,y` -- DBR
;  relative -- which is exactly why the callers set it.
; ======================================================================
kv_language:
.word $0000, !text_lang_en : .byt ^text_lang_en
.word $0001, !text_lang_ptbr : .byt ^text_lang_ptbr
.word $0002, !text_lang_es : .byt ^text_lang_es
.word $0003, !text_lang_de : .byt ^text_lang_de
.word $0004, !text_lang_fr : .byt ^text_lang_fr
.word $0005, !text_lang_it : .byt ^text_lang_it
.word $0006, !text_lang_ru : .byt ^text_lang_ru
.word $0007, !text_lang_nl : .byt ^text_lang_nl
.word $0008, !text_lang_ja : .byt ^text_lang_ja
.word $0009, !text_lang_zh : .byt ^text_lang_zh
.word $ffff

kv_bsx_timesource:
.word $0000, !text_rtc : .byt ^text_rtc
.word $0001, !text_custom : .byt ^text_custom
.word $ffff

kv_onoff:
.word $0000, !text_off : .byt ^text_off
.word $0001, !text_on : .byt ^text_on
.word $ffff

; Tri-state for the two font-edge options (TEXT_EDGE_* in src/theme.h).  Not a bool
; because the font remap can only REMOVE an edge: with a plain on/off the .thm always
; had the last word, so "On" did nothing visible on a theme that asks for outline-off.
; THEME is 0 so an old config.yml -- and anything cfg.c clamps -- lands on it.
kv_text_edge:
.word $0000, !text_theme : .byt ^text_theme
.word $0001, !text_on : .byt ^text_on
.word $0002, !text_off : .byt ^text_off
.word $ffff

; Copier-header convention of one IPS patch, edited through PATCH_HDR_SEL.
; Values match PATCH_HDR_AUTO/HEADERED/HEADERLESS >> PATCH_FLAG_HDR_SHIFT.
kv_patch_hdrmode:
.word $0000, !text_patch_hdrsel_auto : .byt ^text_patch_hdrsel_auto
.word $0001, !text_patch_hdrsel_on : .byt ^text_patch_hdrsel_on
.word $0002, !text_patch_hdrsel_off : .byt ^text_patch_hdrsel_off
.word $ffff

; cover size: 1=large (legacy "on"), 2=small (half, 8x8 sprites), 0=off. Cycle
; order large->small->off; CFG default is 1 so an existing "ShowCovers: true"
; config (parsed to 1) shows "Large".
kv_cover_size:
.word $0001, !text_cover_large : .byt ^text_cover_large
.word $0002, !text_cover_small : .byt ^text_cover_small
.word $0000, !text_off : .byt ^text_off
.word $ffff

; ShowGameInfo is tri-state: 0 = off, 1 = on (auto-show before boot), 2 = context
; (no auto-show; the info screen is reachable from the file context menu instead).
; Listed in NUMERIC order, unlike kv_cover_size above: that one is reordered so the
; "value not in the table -> fall back to the first row" sanitize lands on a sane
; default, but here cfg_load clamps ShowGameInfo into 0..2, so every stored value is
; always present in the table and that fallback is unreachable. With nothing to gain
; from reordering, keep the shape of kv_onoff / kv_patch_hdrmode and let the scroll
; order read Off -> On -> Context.
kv_gameinfo_mode:
.word $0000, !text_off : .byt ^text_off
.word $0001, !text_on : .byt ^text_on
.word $0002, !text_gameinfo_context : .byt ^text_gameinfo_context
.word $ffff

kv_rst_to_menu:
.word $0000, !text_off : .byt ^text_off
.word $0001, !text_on : .byt ^text_on
.word $0002, !text_nav_folder : .byt ^text_nav_folder
.word $0003, !text_nav_rom : .byt ^text_nav_rom
; Duration keeps the PHYSICAL short/long detection alive (values 1..3 short-circuit
; it in snes.c and make every press a long reset): a short press just resets the
; running game, a long one goes to the menu exactly like ROM does.
.word $0004, !text_nav_duration : .byt ^text_nav_duration
.word $ffff

kv_enabledisable:
.word $0000, !text_enabled : .byt ^text_enabled
.word $0001, !text_disabled : .byt ^text_disabled
.word $ffff

kv_yesno:
.word $0000, !text_no : .byt ^text_no
.word $0001, !text_yes : .byt ^text_yes
.word $ffff

kv_vmode:
.word $0002, !text_auto : .byt ^text_auto
kv_vmode_noauto:
.word $0001, !text_50Hz : .byt ^text_50Hz
.word $0000, !text_60Hz : .byt ^text_60Hz
.word $ffff

kv_cx4_speed:
.word $0000, !text_normal : .byt ^text_normal
.word $0001, !text_fast : .byt ^text_fast
.word $ffff

kv_gsu_speed:
.word $0000, !text_normal : .byt ^text_normal
.word $0001, !text_fast : .byt ^text_fast
.word $ffff

; Atari 2600 picture width, shipped to the core as feat16[5]: 0 = the native
; 160 px TIA raster 1:1 (pillarboxed), 1 = 256 px (5 source pixels stretched to
; 8) filling the screen. cfg_load clamps A26VideoWidth into 0..1, so the
; "value not in the table -> first row" fallback is unreachable; numeric order.
kv_a26_width:
.word $0000, !text_a26_w160 : .byt ^text_a26_w160
.word $0001, !text_a26_w256 : .byt ^text_a26_w256
.word $ffff

kv_sgb_clock:
.word $0000, !text_sgb_clock1 : .byt ^text_sgb_clock1
.word $0001, !text_sgb_clock2 : .byt ^text_sgb_clock2
.word $ffff

; GbcMode (CFG+$1D1): 0 Auto / 1 Prefer SGB / 2 Prefer GBC -- gbc_mode_t in
; src/gbc.h. cfg_load clamps it into 0..2, so every stored value is in the table;
; numeric order.
kv_gbc_mode:
.word $0000, !text_auto : .byt ^text_auto
.word $0001, !text_gbc_prefer_sgb : .byt ^text_gbc_prefer_sgb
.word $0002, !text_gbc_prefer_gbc : .byt ^text_gbc_prefer_gbc
.word $ffff

; GbcSync (CFG+$1D2): 0 Genlock / 1 Exact -- gbc_sync_t in src/gbc.h.
kv_gbc_sync:
.word $0000, !text_gbc_genlock : .byt ^text_gbc_genlock
.word $0001, !text_gbc_exact : .byt ^text_gbc_exact
.word $ffff

; mfunc_isenabled_gbc -- greying predicate of the three Game Boy Color rows of the
; SGB menu (menudata.a65).  The GBC core has no Spartan-3 build and the Mk.II
; firmware ignores GbcMode/GbcSync/GbcStretch, so the rows are drawn disabled whenever the
; board flag ST_IS_MK2 is set.  Carry set = drawn disabled.  COSMETIC only, like
; every mfunc_isenabled_* (menu_check_disabled_func only picks a palette), hence
; the "Mk.III only" in every description.  Entered by rtl from
; menu_check_disabled_func with A in 8 bits, which is also why it may live in $C1.
mfunc_isenabled_gbc:
  .as
  lda @ST_IS_MK2
  cmp #$01                   ; C = 1 for any non-zero flag (Mk.II)
  rtl

kv_screensaver_timeout:
.word $0001, !text_1min : .byt ^text_1min
.word $0002, !text_2min : .byt ^text_2min
.word $0003, !text_3min : .byt ^text_3min
.word $0004, !text_4min : .byt ^text_4min
.word $0005, !text_5min : .byt ^text_5min
.word $000a, !text_10min : .byt ^text_10min
.word $000f, !text_15min : .byt ^text_15min
.word $0014, !text_20min : .byt ^text_20min
.word $001e, !text_30min : .byt ^text_30min
.word $002d, !text_45min : .byt ^text_45min
.word $003c, !text_60min : .byt ^text_60min
.word $ffff

kv_volume_boost:
.word $0000, !text_off : .byt ^text_off
.word $0001, !text_3_5db : .byt ^text_3_5db
.word $0002, !text_6db : .byt ^text_6db
.word $0003, !text_9_5db : .byt ^text_9_5db
.word $0004, !text_12db : .byt ^text_12db
.word $ffff

kv_bright_limit:
.word $0008, !text_minus7 : .byt ^text_minus7
.word $0009, !text_minus6 : .byt ^text_minus6
.word $000a, !text_minus5 : .byt ^text_minus5
.word $000b, !text_minus4 : .byt ^text_minus4
.word $000c, !text_minus3 : .byt ^text_minus3
.word $000d, !text_minus2 : .byt ^text_minus2
.word $000e, !text_minus1 : .byt ^text_minus1
.word $000f, !text_off : .byt ^text_off
.word $ffff

kv_savestates:
.word $0000, !text_off : .byt ^text_off
.word $0001, !text_on : .byt ^text_on
;.word $0001, !text_on_p1 : .byt ^text_on_p1
;.word $0002, !text_on_p2 : .byt ^text_on_p2
.word $ffff

opt_0_to_30:
.word $0000, $001E

opt_1_to_2:
.word $0001, $0002

kv_led_bright:
.word $0000, !text_off : .byt ^text_off
.word $0001, !text_1 : .byt ^text_1
.word $0002, !text_2 : .byt ^text_2
.word $0003, !text_3 : .byt ^text_3
.word $0004, !text_4 : .byt ^text_4
.word $0005, !text_5 : .byt ^text_5
.word $0006, !text_6 : .byt ^text_6
.word $0007, !text_7 : .byt ^text_7
.word $0008, !text_8 : .byt ^text_8
.word $0009, !text_9 : .byt ^text_9
.word $000a, !text_10 : .byt ^text_10
.word $000b, !text_11 : .byt ^text_11
.word $000c, !text_12 : .byt ^text_12
.word $000d, !text_13 : .byt ^text_13
.word $000e, !text_14 : .byt ^text_14
.word $000f, !text_15_max : .byt ^text_15_max
