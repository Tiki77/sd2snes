# GUARD BAND -- do not drop this line (same rationale as the spc7110 core's ucf):
# Spartan-3 trce computes NO clock uncertainty (INFO Timing:3389/3390) and CLK2
# is the CLKFX output of a DCM whose measured period jitter is 0.75 ns peak to
# peak (stamped in the DCM header).  SYSTEM_JITTER becomes a per-path
# uncertainty of jitter/sqrt(2), so 0.48 ns buys a ~0.34 ns guard band without
# touching the PERIOD itself.  0.48 is the LARGEST value the spc7110 design
# closes on; if this variant fails to close timing at 0.48, lower the value
# rather than dropping the line (an unreachable constraint makes place-and-route
# give up early and the physical result gets dramatically worse).
SYSTEM_JITTER = 0.48 ns;

# Half-rate FX3 core (GSU3_HALF in main.v): gsu_fx3 runs with a clock enable on every
# other CLK2 edge, so register-to-register paths INSIDE the core get two CLK2 periods
# (2 x 11.66 ns, rounded down).  Paths into and out of the core (bus handshake, CE,
# SNES strobes) stay single-cycle under the CLK2 PERIOD.  Valid only while EVERY
# register and RAM of gsu_fx3 is written under `if (CE)` -- a new always block in
# there that is not would be signed against a period it does not have.
INST "snes_gsu/*" TNM = "TNM_gsu";
TIMESPEC "TS_gsu_half" = FROM "TNM_gsu" TO "TNM_gsu" 23.3 ns;
